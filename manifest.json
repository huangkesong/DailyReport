{
  "manifest_version": 3,
  "name": "日报助手",
  "version": "1.0",
  "description": "一个帮助记录和管理日报的Chrome插件",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "sidePanel"
  ],
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  }
}